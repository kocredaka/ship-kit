# Copy to .env and fill in. NEVER commit a real .env file.
# .env is gitignored; .env.example is the committed template.

# Deployer private key (64 hex chars, with or without 0x prefix).
# FUJI ONLY: use a fresh throwaway key from `cast wallet new`.
# NEVER put a mainnet key with real funds here.
PRIVATE_KEY=

# RPC endpoints (defaults already set in foundry.toml; override only if needed).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CCHAIN_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Free Snowtrace API key (https://snowtrace.io/apis) for contract verification.
SNOWTRACE_API_KEY=

# Optional greeting for the Greeter demo deploy.
GREETER_MESSAGE=hello, avalanche
